# =============================================================================
# Plane Frontend Only - For Render/Koyeb Free Tier
# =============================================================================
FROM node:22-alpine AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

# Install dependencies
RUN apk add --no-cache libc6-compat git

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps/web ./apps/web

# Install and build
RUN corepack enable pnpm && \
    pnpm install --frozen-lockfile

# Build arguments
ARG VITE_API_BASE_URL=""
ARG VITE_ADMIN_BASE_URL=""
ARG VITE_ADMIN_BASE_PATH="/god-mode"
ARG VITE_LIVE_BASE_URL=""
ARG VITE_LIVE_BASE_PATH="/live"
ARG VITE_SPACE_BASE_URL=""
ARG VITE_SPACE_BASE_PATH="/spaces"
ARG VITE_WEB_BASE_URL=""

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ADMIN_BASE_URL=$VITE_ADMIN_BASE_URL
ENV VITE_ADMIN_BASE_PATH=$VITE_ADMIN_BASE_PATH
ENV VITE_LIVE_BASE_URL=$VITE_LIVE_BASE_URL
ENV VITE_LIVE_BASE_PATH=$VITE_LIVE_BASE_PATH
ENV VITE_SPACE_BASE_URL=$VITE_SPACE_BASE_URL
ENV VITE_SPACE_BASE_PATH=$VITE_SPACE_BASE_PATH
ENV VITE_WEB_BASE_URL=$VITE_WEB_BASE_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV TURBO_TELEMETRY_DISABLED=1

RUN pnpm turbo run build --filter=web

# =============================================================================
# Production stage with nginx
# =============================================================================
FROM nginx:1.27-alpine

# Install envsubst for runtime env var substitution
RUN apk add --no-cache gettext

COPY apps/web/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/apps/web/build/client /usr/share/nginx/html

# Create env config template
RUN echo 'window.ENV = {' > /usr/share/nginx/html/env-config.js.template && \
    echo '  VITE_API_BASE_URL: "${VITE_API_BASE_URL}",' >> /usr/share/nginx/html/env-config.js.template && \
    echo '  VITE_WEB_BASE_URL: "${VITE_WEB_BASE_URL}",' >> /usr/share/nginx/html/env-config.js.template && \
    echo '  VITE_ADMIN_BASE_URL: "${VITE_ADMIN_BASE_URL}",' >> /usr/share/nginx/html/env-config.js.template && \
    echo '  VITE_ADMIN_BASE_PATH: "${VITE_ADMIN_BASE_PATH}",' >> /usr/share/nginx/html/env-config.js.template && \
    echo '  VITE_LIVE_BASE_URL: "${VITE_LIVE_BASE_URL}",' >> /usr/share/nginx/html/env-config.js.template && \
    echo '  VITE_LIVE_BASE_PATH: "${VITE_LIVE_BASE_PATH}",' >> /usr/share/nginx/html/env-config.js.template && \
    echo '  VITE_SPACE_BASE_URL: "${VITE_SPACE_BASE_URL}",' >> /usr/share/nginx/html/env-config.js.template && \
    echo '  VITE_SPACE_BASE_PATH: "${VITE_SPACE_BASE_PATH}"' >> /usr/share/nginx/html/env-config.js.template && \
    echo '};' >> /usr/share/nginx/html/env-config.js.template

# Create startup script
RUN printf '#!/bin/sh\n\
# Substitute environment variables in config\n\
envsubst < /usr/share/nginx/html/env-config.js.template > /usr/share/nginx/html/env-config.js\n\
# Start nginx\n\
exec nginx -g "daemon off;"\n' > /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/ >/dev/null || exit 1

CMD ["/docker-entrypoint.sh"]
